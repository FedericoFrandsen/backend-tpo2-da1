{
  "info": {
    "name": "Hallado API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Backend Hallado. Primero cargar seed y ejecutar login. Para registro usar un email nuevo y copiar OTP. Para aceptar un reclamo hay que usar la sesión del autor de la publicación; el reclamante usa otra cuenta."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "demo@hallado.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Hallado123",
      "type": "string"
    },
    {
      "key": "purpose",
      "value": "registration",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "COPIAR_DESDE_CONSOLA_O_EMAIL",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "demo-lucia",
      "type": "string"
    },
    {
      "key": "publicacionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reclamoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "alertaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificacionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "filename",
      "value": "",
      "type": "string"
    },
    {
      "key": "fotoUrl",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); pm.variables.set(\"today\", d.getFullYear()+\"-\"+String(d.getMonth()+1).padStart(2,\"0\")+\"-\"+String(d.getDate()).padStart(2,\"0\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Fotos",
      "item": [
        {
          "name": "POST /uploads/images",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/uploads/images",
            "description": "Ver docs/INTEGRACION.md. Las rutas privadas usan el token Bearer de la colección.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": null,
                  "description": "Seleccioná una foto JPEG, PNG o WebP menor a 5 MB."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"filename\", r.filename); pm.collectionVariables.set(\"fotoUrl\", r.url); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /uploads/:filename",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/uploads/{{filename}}",
            "description": "Ver docs/INTEGRACION.md. Las rutas privadas usan el token Bearer de la colección."
          }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST /auth/otp/request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/otp/request",
            "description": "Ver docs/INTEGRACION.md. Las rutas privadas usan el token Bearer de la colección.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"purpose\": \"{{purpose}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /auth/otp/resend",
          "request": {
            "method": "POST",
            "header": [
